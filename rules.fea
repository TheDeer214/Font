feature calt {

    # 1. Define sets of characters that trigger connectivity
    #    (e.g., all symbols that can start an arrow)
    @CONNECT_START = [hyphen equal exclam slash asterisk bar];

    # 2. Define the middle characters (the spine of a multi-char arrow)
    @CONNECT_MIDDLE = [hyphen equal bar];

    # 3. Define the ending character (the arrowhead)
    @CONNECT_END = [greater];

    # --- THE RULES ---

    # Rule A: If you see a connectable start and middle sequence,
    # convert the start character to a long, perfectly aligned variant.
    sub @CONNECT_START' @CONNECT_MIDDLE by hyphen.LIGA_START;

    # Rule B: If you see a middle character followed by another middle
    # character, convert the current middle to a matching long variant.
    sub @CONNECT_MIDDLE' @CONNECT_MIDDLE by hyphen.LIGA_MIDDLE;

    # Rule C: When any connective character is followed immediately
    # by a '>' (arrowhead), swap the arrowhead for a aligned variant.
    sub [@CONNECT_START @CONNECT_MIDDLE]' @CONNECT_END by greater.LIGA_END;

} calt;
