feature calt {
    # --- Arrows ---
    sub hyphen greater by hyphen_greater;        # ->
    sub equal equal greater by fat_arrow;        # =>
    sub less hyphen by less_hyphen;              # <-

    # --- Comparisons & Logic ---
    sub exclam equal by notequal;                # !=
    sub less equal by less_equal;                # <=
    sub greater equal by greater_equal;          # >=
    sub equal equal equal by triple_equal;       # ===
    sub exclam equal equal by not_triple_equal;  # !==

    # --- Comments & Special ---
    sub slash slash by slash_slash;              # //
} calt;
